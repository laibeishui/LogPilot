{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "Sqlite": {
      "DataSource": "./data/logpilot.db"
    },
    "VictoriaLogs": {
      "BaseUrl": "http://localhost:9428",
      "TimeoutSeconds": 10
    }
  },
  "Ingestion": {
    "MaxBatchRecords": 500,
    "MaxBodyBytes": 1048576,
    "MaxRecordBytes": 65536,
    "MaxAttributes": 64,
    "MaxAttributeDepth": 8,
    "RequestTimeoutSeconds": 10,
    "MaxRequestsPerMinute": 600
  },
  "Query": {
    "DefaultRangeMinutes": 15,
    "DefaultPageSize": 50,
    "MaxPageSize": 100,
    "QueryTimeoutSeconds": 15,
    "StreamRecheckSeconds": 30
  },
  "Alerting": {
    "ConfigKey": ""
  }
}
