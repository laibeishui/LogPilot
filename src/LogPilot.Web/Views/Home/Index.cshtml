@{
  ViewData["Title"] = "总览";
}
<div class="headline">
  <div>
    <h1>运行总览</h1>
    <p>集中管理应用日志，快速定位问题。</p>
  </div>
  <div class="rows" style="align-items:center">
    <label class="muted" for="projectId">项目</label>
    <select id="projectId" class="field" style="min-width:200px"></select>
  </div>
</div>

<div id="notice" class="notice" style="display:none"></div>

<!-- 健康状态 -->
<div class="card" style="margin-bottom:16px;padding:14px 18px">
  <div class="rows" id="healthRows">
    <div class="line"><span>LogPilot Server</span><span class="muted">检测中…</span></div>
    <div class="line"><span>VictoriaLogs</span><span class="muted">检测中…</span></div>
    <div class="line"><span>SQLite</span><span class="muted">检测中…</span></div>
    <div class="line"><span>告警评估引擎</span><span class="muted">检测中…</span></div>
  </div>
</div>

<!-- KPI -->
<div class="kpis">
  <div class="card kpi">
    <div class="muted">日志总数</div>
    <div class="val" id="kpiTotal">—</div>
    <div class="muted" id="kpiTotalSub">选择项目</div>
  </div>
  <div class="card kpi">
    <div class="muted">错误日志</div>
    <div class="val red" id="kpiErrors">—</div>
    <div class="muted" id="kpiErrorsSub">ERROR / FATAL</div>
  </div>
  <div class="card kpi">
    <div class="muted">接入服务</div>
    <div class="val" id="kpiServices">—</div>
    <div class="muted" id="kpiServicesSub">当前时间窗</div>
  </div>
</div>

<!-- 趋势 + 快捷 -->
<div class="two" style="margin-top:18px">
  <div class="card pad">
    <div class="sectionhead">
      <h3 style="margin:0">日志趋势</h3>
      <span class="muted small">最近 12 个时段</span>
    </div>
    <div id="trendChart" style="height:240px;width:100%;display:none"></div>
    <div id="trendPlaceholder" class="muted" style="height:240px;display:flex;align-items:center;justify-content:center">选择项目后显示</div>
  </div>
  <div class="card pad">
    <div class="sectionhead">
      <h3 style="margin:0">快捷操作</h3>
    </div>
    <div class="rows">
      <a class="btn" asp-controller="Logs" asp-action="Index">查询日志 →</a>
      <a class="btn" asp-controller="Projects" asp-action="Index">项目管理 →</a>
      <a class="btn" asp-controller="Integrations" asp-action="Index">接入中心 →</a>
      <a class="btn" asp-controller="Alerts" asp-action="Index">告警中心 →</a>
      <hr style="border:0;border-top:1px solid var(--line);width:100%;margin:4px 0">
      <div class="line"><span class="muted">健康端点</span><a href="/health/ready">/health/ready</a></div>
    </div>
  </div>
</div>

<!-- 异常聚合 -->
<div class="card pad" style="margin-top:18px">
  <div class="sectionhead">
    <h3 style="margin:0">异常聚合</h3>
    <span class="muted small" id="excMeta">按指纹归并同类错误</span>
  </div>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>问题</th>
          <th>服务</th>
          <th>级别</th>
          <th style="text-align:right">次数</th>
          <th>首次</th>
          <th>最近</th>
        </tr>
      </thead>
      <tbody id="exceptionsBody">
        <tr><td colspan="6" class="muted">选择项目后加载</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- 最近错误 -->
<div class="card pad" style="margin-top:18px">
  <div class="sectionhead">
    <h3 style="margin:0">最近错误</h3>
    <a class="btn" asp-controller="Logs" asp-action="Index" id="viewAllErrors">查看全部</a>
  </div>
  <div class="tablewrap">
    <table>
      <thead>
        <tr>
          <th>时间</th>
          <th>级别</th>
          <th>服务</th>
          <th>消息</th>
        </tr>
      </thead>
      <tbody id="errorsBody">
        <tr><td colspan="4" class="muted">选择项目后加载</td></tr>
      </tbody>
    </table>
  </div>
</div>

<style>
  .two { display:grid; grid-template-columns:1.5fr 1fr; gap:18px; }
  .sectionhead { display:flex; align-items:center; justify-content:space-between; margin-bottom:15px; gap:12px; }
  .sectionhead h3 { margin:0; font-size:16px; }
  .pad { padding:18px 20px; }
  .small { font-size:12px; }
  @@media(max-width:1000px){ .two{grid-template-columns:1fr} .kpis{grid-template-columns:repeat(2,1fr)} }
  @@media(max-width:620px){ .kpis{grid-template-columns:1fr} }
</style>

@section Scripts {
<script src="~/lib/echarts/echarts.min.js" asp-append-version="true"></script>
<script>
(() => {
  const $ = id => document.getElementById(id);
  const projectSelect = $('projectId');
  const notice = $('notice');
  let currentProjectId = null;

  function escapeHtml(s) {
    return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function showNotice(text, isError) {
    notice.style.display = 'block';
    notice.textContent = text;
    notice.style.background = isError ? '#ffebee' : '#fff8e9';
    notice.style.color = isError ? '#d74652' : '#8a6420';
    notice.style.borderColor = isError ? '#ffcdd2' : '#ffe8ba';
  }

  function levelClass(level) {
    const v = String(level || '').toLowerCase();
    if (v.includes('error') || v.includes('fatal')) return 'error';
    if (v.includes('warn')) return 'warn';
    if (v.includes('debug') || v.includes('trace')) return 'debug';
    return 'info';
  }

  // —— 健康状态 ——
  async function loadHealth() {
    try {
      const report = await LogPilotApi.api('/health/ready');
      const map = {
        'LogPilot': report.logPilot,
        'VictoriaLogs': report.victoriaLogs,
        'SQLite': report.sqlite,
        '告警评估引擎': report.alertEvaluator
      };
      const rows = $('healthRows');
      rows.innerHTML = Object.entries(map).map(([name, comp]) => {
        if (!comp) return `<div class="line"><span>${name}</span><span class="muted">未启用</span></div>`;
        const ok = comp.status === 0 || String(comp.status).toLowerCase() === 'healthy';
        const label = ok ? '● 可用' : ('● ' + (comp.statusText || comp.status));
        return `<div class="line"><span>${name}</span><span class="${ok ? 'green' : 'red'}">${label}${comp.detail ? ' · ' + escapeHtml(comp.detail) : ''}</span></div>`;
      }).join('');
    } catch (e) {
      $('healthRows').innerHTML = `<div class="line"><span>健康检查</span><span class="red">失败：${escapeHtml(e.message)}</span></div>`;
    }
  }

  // —— 项目列表 ——
  async function loadProjects() {
    try {
      const items = await LogPilotApi.api('/api/v1/projects');
      projectSelect.innerHTML = items.map(p =>
        `<option value="${p.id}">${escapeHtml(p.name)} (${escapeHtml(p.code)})</option>`
      ).join('') || '<option value="">暂无项目</option>';
      if (projectSelect.value) {
        currentProjectId = projectSelect.value;
        loadAll();
      }
    } catch (e) {
      showNotice('加载项目失败: ' + e.message, true);
    }
  }

  // —— 概览 KPI ——
  async function loadOverview() {
    if (!currentProjectId) return;
    const qs = new URLSearchParams({ projectId: currentProjectId });
    try {
      const o = await LogPilotApi.api('/api/v1/stats/overview?' + qs.toString());
      $('kpiTotal').textContent = o.totalLogs.toLocaleString();
      $('kpiTotalSub').textContent = `${fmtTime(o.startTime)} ~ ${fmtTime(o.endTime)}`;
      $('kpiErrors').textContent = o.errorLogs.toLocaleString();
      $('kpiServices').textContent = o.serviceCount;
    } catch (e) {
      $('kpiTotal').textContent = '—';
      $('kpiErrors').textContent = '—';
      $('kpiServices').textContent = '—';
      console.warn(e);
    }
  }

  // —— 趋势图（ECharts） ——
  let trendChart = null;

  function showTrendPlaceholder(text) {
    const box = $('trendPlaceholder');
    box.textContent = text;
    box.style.display = 'flex';
    $('trendChart').style.display = 'none';
  }

  function renderTrend(last12) {
    const el = $('trendChart');
    if (!window.echarts) { showTrendPlaceholder('图表库未加载'); return; }
    $('trendPlaceholder').style.display = 'none';
    el.style.display = 'block';
    if (!trendChart) trendChart = window.echarts.init(el);
    trendChart.setOption({
      grid: { left: 8, right: 14, top: 40, bottom: 6, containLabel: true },
      tooltip: { trigger: 'axis' },
      legend: { data: ['全部日志', '错误日志'], right: 0, top: 2, itemWidth: 12, itemHeight: 10, textStyle: { color: '#66758a', fontSize: 12 } },
      xAxis: { type: 'category', data: last12.map(p => fmtTime(p.time)), axisLine: { lineStyle: { color: '#e6eaf0' } }, axisLabel: { color: '#66758a', fontSize: 11 } },
      yAxis: { type: 'value', minInterval: 1, splitLine: { lineStyle: { color: '#eef1f6' } }, axisLabel: { color: '#66758a', fontSize: 11 } },
      series: [
        { name: '全部日志', type: 'bar', data: last12.map(p => p.count), itemStyle: { color: '#7895ff', borderRadius: [4, 4, 0, 0] }, barMaxWidth: 22 },
        { name: '错误日志', type: 'bar', data: last12.map(p => p.errors), itemStyle: { color: '#f27988', borderRadius: [4, 4, 0, 0] }, barMaxWidth: 22 }
      ]
    });
    trendChart.resize();
  }

  async function loadTrend() {
    if (!currentProjectId) return;
    const qs = new URLSearchParams({ projectId: currentProjectId, interval: '5m' });
    try {
      const t = await LogPilotApi.api('/api/v1/stats/trend?' + qs.toString());
      const last12 = (t.points || []).slice(-12);
      if (last12.length === 0) { showTrendPlaceholder('暂无数据'); return; }
      renderTrend(last12);
    } catch (e) {
      showTrendPlaceholder('加载失败');
      console.warn(e);
    }
  }

  // —— 最近错误 ——
  async function loadRecentErrors() {
    if (!currentProjectId) return;
    const end = new Date();
    const start = new Date(end.getTime() - 15 * 60 * 1000);
    try {
      const result = await LogPilotApi.api('/api/v1/logs/search', {
        method: 'POST',
        body: {
          projectId: Number(currentProjectId),
          startTime: start.toISOString(),
          endTime: end.toISOString(),
          levels: ['ERROR', 'FATAL'],
          pageSize: 10
        }
      });
      const items = result.items || [];
      $('errorsBody').innerHTML = items.map(x => `
        <tr class="clickable" data-id="${escapeHtml(x.id)}" data-ts="${escapeHtml(x.timestamp)}">
          <td style="white-space:nowrap">${escapeHtml(new Date(x.timestamp).toLocaleString())}</td>
          <td><span class="tag ${levelClass(x.level)}">${escapeHtml(x.level)}</span></td>
          <td>${escapeHtml(x.serviceName)}</td>
          <td class="msg" title="${escapeHtml(x.message)}">${escapeHtml(x.message)}</td>
        </tr>`).join('') || '<tr><td colspan="4" class="muted">近 15 分钟无错误日志</td></tr>';
    } catch (e) {
      $('errorsBody').innerHTML = `<tr><td colspan="4" class="muted">加载失败：${escapeHtml(e.message)}</td></tr>`;
    }
  }

  // —— 异常聚合 ——
  async function loadExceptions() {
    if (!currentProjectId) return;
    const qs = new URLSearchParams({ projectId: currentProjectId, top: '10' });
    try {
      const r = await LogPilotApi.api('/api/v1/stats/exceptions?' + qs.toString());
      const groups = r.groups || [];
      $('excMeta').textContent = r.scanned
        ? `扫描 ${r.scanned} 条错误${r.truncated ? '（达上限，实际可能更多）' : ''} · 归并为 ${groups.length} 个问题`
        : '按指纹归并同类错误';
      $('exceptionsBody').innerHTML = groups.map(g => `
        <tr class="clickable" data-ts="${escapeHtml(g.lastSeen)}">
          <td class="msg" title="${escapeHtml(g.sampleMessage)}"><strong>${escapeHtml(g.title)}</strong></td>
          <td>${escapeHtml(g.serviceName)}</td>
          <td><span class="tag ${levelClass(g.level)}">${escapeHtml(g.level)}</span></td>
          <td style="text-align:right">${Number(g.count).toLocaleString()}</td>
          <td style="white-space:nowrap" class="muted small">${escapeHtml(new Date(g.firstSeen).toLocaleString())}</td>
          <td style="white-space:nowrap" class="muted small">${escapeHtml(new Date(g.lastSeen).toLocaleString())}</td>
        </tr>`).join('') || '<tr><td colspan="6" class="muted">时间窗内无错误日志</td></tr>';
    } catch (e) {
      $('exceptionsBody').innerHTML = `<tr><td colspan="6" class="muted">加载失败：${escapeHtml(e.message)}</td></tr>`;
    }
  }

  function fmtTime(iso) {
    try { return new Date(iso).toLocaleTimeString(); } catch { return iso; }
  }

  async function loadAll() {
    await Promise.all([loadOverview(), loadTrend(), loadExceptions(), loadRecentErrors()]);
  }

  projectSelect.addEventListener('change', () => {
    currentProjectId = projectSelect.value;
    if (currentProjectId) loadAll();
  });

  loadHealth();
  loadProjects();

  window.addEventListener('resize', () => trendChart?.resize());

  // 点击错误行跳转到日志详情
  $('errorsBody').addEventListener('click', (e) => {
    const tr = e.target.closest('tr[data-id]');
    if (tr) {
      location.href = `/logs?projectId=${currentProjectId}&auto=1`;
    }
  });
})();
</script>
}
