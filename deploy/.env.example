# 复制为 deploy/.env 后按需修改
#   Windows:  copy deploy\.env.example deploy\.env
#   Linux:    cp deploy/.env.example deploy/.env

# ----- LogPilot -----
LOGPILOT_HTTP_PORT=8080
LOGPILOT_IMAGE_TAG=local

# 数据目录：命名卷名 或 宿主机路径（如 ./data/logpilot）
LOGPILOT_DATA_PATH=logpilot-data
VICTORIALOGS_DATA_PATH=victorialogs-data

# ----- VictoriaLogs -----
VICTORIALOGS_VERSION=v1.53.0
VICTORIALOGS_RETENTION=7d
VICTORIALOGS_TIMEOUT_SECONDS=10
# 仅 compose.vl-only.yml 使用（本机访问 VL）
VICTORIALOGS_PUBLISH_PORT=9428

# ----- 限额（可选，全栈 compose 读取）-----
INGEST_MAX_BATCH=500
INGEST_MAX_BODY_BYTES=1048576
QUERY_MAX_RANGE_HOURS=24
